# =========================
# 1. 模型提供方
# =========================
# 可选值：
# - zhipu
# - openai
# - azure_openai
LLM_PROVIDER=zhipu

# 默认模型名。不同 provider 下也可以使用下面的专用模型变量覆盖。
LLM_MODEL=

# 可选：按 agent 指定模型，必须是 JSON 对象字符串。
# 示例：{"hypothesis_agent":"glm-4-flash","experiment_designer_agent":"glm-4-flash"}
AGENT_MODEL_MAP=

# =========================
# 2. 智谱模型配置
# =========================
# 当 LLM_PROVIDER=zhipu 时必填。
ZHIPU_API_KEY=你的智谱APIKey
ZHIPU_MODEL=glm-4-flash

# =========================
# 3. OpenAI 兼容接口配置
# =========================
# 当 LLM_PROVIDER=openai 或其他 OpenAI 兼容 provider 时使用。
OPENAI_API_KEY=你的OpenAI或兼容接口APIKey
OPENAI_BASE_URL=
# 使用 OpenAI 兼容接口时，LLM_MODEL 必填。
# LLM_MODEL=gpt-4o-mini

# =========================
# 4. Azure OpenAI 配置
# =========================
# 当 LLM_PROVIDER=azure_openai 时使用。
AZURE_OPENAI_API_KEY=你的AzureOpenAI密钥
AZURE_OPENAI_ENDPOINT=https://你的资源名.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT=你的部署名

# =========================
# 5. 普通示例入口配置
# =========================
# examples/run_alpha_factor_mining_loop.py 会读取这些变量。
LOOP_COUNT=2
INITIAL_DIRECTION=山寨币在过热时可能会发生反转，基于这个假设可以发掘盈利因子。

# 限制 FactorCoder 内部迭代次数，调试时建议保持较小。
FACTOR_CODER_MAX_LOOP=1
FACTOR_CODER_FAIL_TASK_TRIAL_LIMIT=1

# =========================
# 6. 遗传迭代模式配置
# =========================
# main.py 和 examples/run_alpha_factor_mining_loop.py 都支持这些变量。
EVOLUTION_MODE=false
EVOLUTION_MAX_ROUNDS=3
EVOLUTION_NUM_INITIAL_DIRECTIONS=5
EVOLUTION_MUTATION_TASKS_PER_ROUND=3
EVOLUTION_CROSSOVER_TASKS_PER_ROUND=2
EVOLUTION_EVOLVED_DIRECTIONS_PER_ROUND=5
EVOLUTION_MUTATION_PARENT_TOP_N=10
EVOLUTION_CROSSOVER_PARENT_TOP_N=10
EVOLUTION_MUTATION_TOP_N=2
EVOLUTION_CROSSOVER_GROUP_SIZE=2
EVOLUTION_CROSSOVER_N_GROUPS=1

# =========================
# 7. 实验设计与校验配置
# =========================
# FAST_MODE=true 时会跳过部分大模型校验和反馈调用，适合快速连通性测试。
FAST_MODE=false

# LLM verifier 默认开启。关闭后表达式语义一致性校验会跳过大模型判断。
LLM_VERIFIER_ENABLED=true

# 控制 ExperimentDesigner 每次产出的因子数量。
EXPERIMENT_DESIGNER_MIN_FACTORS=1
EXPERIMENT_DESIGNER_MAX_FACTORS=3
# 如需固定数量，可以设置 target；为空则使用 min/max。
EXPERIMENT_DESIGNER_TARGET_FACTOR_COUNT=

# ExperimentDesigner 生成失败后的最大重试次数。
EXPERIMENT_DESIGNER_MAX_ATTEMPTS=3
